# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Everything is optional: any vendor without a key falls back to its mock,
# so the app always runs. Run `npm run preflight` after editing to validate.

# ---- Hosting ----
PORT=8080
# Public URL of THIS server. Required for Recall (it builds the bot's display
# page URL and its realtime audio callback from this). Local dev: use an ngrok
# / cloudflared HTTPS tunnel; Render: https://<service>.onrender.com
PUBLIC_BASE_URL=

# ---- State (ADR-0003: never Render's free Postgres/KV) ----
# Neon: https://neon.tech -> project -> connection string
DATABASE_URL=
# Upstash: https://upstash.com -> Redis database -> "rediss://" URL
REDIS_URL=

# ---- Meeting bot (ADR-0001) ----
# https://recall.ai -> dashboard -> API key
RECALL_API_KEY=
# Region your Recall account is on: us-west-2 | us-east-1 | eu-central-1 | ap-northeast-1
RECALL_REGION=us-west-2

# ---- Speech to text (ADR-0004: AssemblyAI chosen; Deepgram stays swappable) ----
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=
# Override the auto-selection: assemblyai | deepgram | mock
# STT_PROVIDER=assemblyai

# ---- LLM ----
ANTHROPIC_API_KEY=
# EXTRACTOR_MODEL=claude-haiku-4-5
# JUDGE_MODEL=claude-opus-5

# ---- Verification search (ADR-0006: our own retrieval layer, the default) ----
# Works with NO keys at all (Wikipedia/Wikidata), but Wikipedia alone is weak on
# statistical claims. Brave is the chosen general-web backend (ADR-0006): an
# independent index, and it returns publication dates, which recency scoring
# uses. Free tier: ~2,000 queries/month, ~1 query/sec.
#   Get a key: https://brave.com/search/api/
BRAVE_API_KEY=
# Brave is metered to stay inside the free tier instead of collecting 429s: at
# most BRAVE_MAX_QUERIES of a claim's planned queries spend quota (the rest go
# to keyless backends), paced at BRAVE_QPS. Raise both on a paid tier.
# BRAVE_QPS=1
# BRAVE_MAX_QUERIES=1
# Additional backends federate with Brave rather than replacing it:
#   ...a self-hosted SearXNG instance (no per-query cost, no third-party key)
SEARXNG_URL=
SEARXNG_TOKEN=
#   ...or Google Programmable Search (100 free queries/day)
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
# Restrict/reorder backends: SEARCH_BACKENDS=brave,wikipedia
# SEARCH_BACKENDS=
# SEARCH_WIKIPEDIA=true

# Commercial alternatives, still supported (SEARCH_PROVIDER=tavily|exa)
TAVILY_API_KEY=
EXA_API_KEY=
# SEARCH_PROVIDER=own | tavily | exa | mock

# Search latency budget (verdict budget is 8-20s end to end)
# SEARCH_DEADLINE_MS=4500
# SEARCH_FETCH_DEADLINE_MS=2500
# SEARCH_MAX_FETCH=5
# SEARCH_CACHE_TTL_SEC=21600

# ---- Optional tuning (defaults in src/config.js) ----
# FALSE_VERDICT_MIN_CONFIDENCE=0.85
# VERDICT_MIN_CONFIDENCE=0.6
# EXTRACT_INTERVAL_MS=5000
# VERIFY_CONCURRENCY=3
# DODGE_TIMEOUT_MS=90000
# LOG_LEVEL=info
# MOCK_SPEED_FACTOR=1
