# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Everything is optional: any vendor without a key falls back to its mock,
# so the app always runs. Run `npm run preflight` after editing to validate.

# ---- Hosting ----
PORT=8080
# Public URL of THIS server. Required for Recall (it builds the bot's display
# page URL and its realtime audio callback from this). Local dev: use an ngrok
# / cloudflared HTTPS tunnel; Render: https://<service>.onrender.com
PUBLIC_BASE_URL=

# ---- State (ADR-0003: never Render's free Postgres/KV) ----
# Neon: https://neon.tech -> project -> connection string
DATABASE_URL=
# Upstash: https://upstash.com -> Redis database -> "rediss://" URL
REDIS_URL=

# ---- Meeting bot (ADR-0001) ----
# https://recall.ai -> dashboard -> API key
RECALL_API_KEY=
# Region your Recall account is on: us-west-2 | us-east-1 | eu-central-1 | ap-northeast-1
RECALL_REGION=us-west-2

# ---- Speech to text (ADR-0004: AssemblyAI chosen; Deepgram stays swappable) ----
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=
# Override the auto-selection: assemblyai | deepgram | mock
# STT_PROVIDER=assemblyai

# ---- LLM (ADR-0007: one switch, any backend) --------------------------------
# LLM_PROVIDER is the global switch. Leave it unset and the first key present
# below is used automatically; set it explicitly to force one.
#
#   hosted:     anthropic | openai | google | azure | groq | together |
#               fireworks | openrouter | deepseek | mistral | xai | cerebras
#   self-hosted: ollama | vllm | lmstudio | llamacpp | localai | custom
#   offline:    mock
#
# NOTE: consumer subscriptions (ChatGPT Plus, Claude Pro/Max) are NOT usable
# here — they are separate products from the APIs and expose no endpoint an app
# can call. And no hosted free tier sustains a live debate: extraction runs ~12
# requests/min, above Cerebras (5 RPM) and Fireworks (10 RPM), while Groq's
# 1,000/day and OpenRouter's 50/day are spent by one debate. Budget a few
# dollars per debate, or self-host — no rate limit, no per-token cost.
# Verified tier-by-tier in docs/VENDOR-TIERS.md.
# LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
AZURE_OPENAI_API_KEY=

# Models. Defaults per provider live in src/providers/llm/registry.js and DO
# drift as vendors rename things — `npm run preflight` prints the id it resolved
# and whether the vendor accepted it.
#   LLM_MODEL      one model for every task (the normal case when self-hosting)
#   *_MODEL        per task; extraction is the cheap high-frequency loop, the
#                  rest decide what appears on screen
# LLM_MODEL=
# EXTRACTOR_MODEL=
# JUDGE_MODEL=
# SCORER_MODEL=
# RECEIPTS_MODEL=

# Run your own model, wherever the app runs — your laptop, or the same VPC in
# AWS/GCP/Azure. No API key is needed; the endpoint is the configuration.
#   LLM_PROVIDER=ollama    LLM_MODEL=llama3.3           (localhost:11434)
#   LLM_PROVIDER=vllm      LLM_MODEL=<the --model id>   (localhost:8000)
#   LLM_PROVIDER=lmstudio  LLM_MODEL=<server tab id>    (localhost:1234)
#   LLM_PROVIDER=llamacpp  LLM_MODEL=any                (localhost:8080)
# Point any provider somewhere else — a remote GPU box, a gateway, a proxy, or
# an Azure deployment URL. Required for `azure` and `custom`.
# LLM_BASE_URL=
# Works for every provider, so an unusual setup needs no vendor-specific name.
# LLM_API_KEY=

# ---- Verification search (ADR-0006: our own retrieval layer, the default) ----
# Works with NO keys at all (Wikipedia/Wikidata), but Wikipedia alone is weak on
# statistical claims. Brave is the chosen general-web backend (ADR-0006): an
# independent index, and it returns publication dates, which recency scoring
# uses. NOT FREE: there is no free plan and a subscription is required before a
# key can be issued. $5.00 per 1,000 requests, with $5 of credit included each
# month — about 1,000 requests, or ~25 hour-long debates at one query per claim.
#   Get a key: https://brave.com/search/api/
BRAVE_API_KEY=
# Capacity is 50 req/sec, so rate is not the constraint — spend is. At
# most BRAVE_MAX_QUERIES of a claim's planned queries spend quota (the rest go
# to keyless backends), paced at BRAVE_QPS. Raise both on a paid tier.
# BRAVE_QPS=1
# BRAVE_MAX_QUERIES=1
# Additional backends federate with Brave rather than replacing it:
#   ...a self-hosted SearXNG instance (no per-query cost, no third-party key)
SEARXNG_URL=
SEARXNG_TOKEN=
#   ...or Google Programmable Search (100 free queries/day)
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
# Restrict/reorder backends: SEARCH_BACKENDS=brave,wikipedia
# SEARCH_BACKENDS=
# SEARCH_WIKIPEDIA=true

# Commercial alternatives, still supported (SEARCH_PROVIDER=tavily|exa)
TAVILY_API_KEY=
EXA_API_KEY=
# SEARCH_PROVIDER=own | tavily | exa | mock

# Search latency budget (verdict budget is 8-20s end to end)
# SEARCH_DEADLINE_MS=4500
# SEARCH_FETCH_DEADLINE_MS=2500
# SEARCH_MAX_FETCH=5
# SEARCH_CACHE_TTL_SEC=21600

# ---- Optional tuning (defaults in src/config.js) ----
# FALSE_VERDICT_MIN_CONFIDENCE=0.85
# VERDICT_MIN_CONFIDENCE=0.6
# EXTRACT_INTERVAL_MS=5000
# VERIFY_CONCURRENCY=3
# DODGE_TIMEOUT_MS=90000
# LOG_LEVEL=info
# MOCK_SPEED_FACTOR=1
